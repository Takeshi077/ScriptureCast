{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScriptureCast",
  "version": "0.1.0",
  "identifier": "com.scripturecast.app",
  "build": {
    "devUrl": "http://localhost:8000",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ScriptureCast",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/whisper-cli"
    ]
  }
}
